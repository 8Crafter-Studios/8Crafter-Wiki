*          text=auto eol=crlf

*.sh       text=auto eol=lf
*.bash     text=auto eol=lf
*.zsh      text=auto eol=lf
*.command  text=auto eol=lf

node_modules/.bin/* text=auto eol=lf

*.cmd      text=auto eol=crlf
*.ps1      text=auto eol=crlf

*.sh       linguist-detectable
